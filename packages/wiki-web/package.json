{
  "name": "@nimbalyst/wiki-web",
  "version": "0.12.3",
  "description": "Browser app for `nim wiki serve`: shows a Nimbalyst local wiki folder in a browser. Static files only; nim serves them.",
  "license": "MIT",
  "type": "module",
  "nimbalystWikiApi": 1,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/nimbalyst/nimbalyst/tree/main/packages/wiki-web#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/nimbalyst/nimbalyst.git",
    "directory": "packages/wiki-web"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:size": "node scripts/check-size.mjs",
    "typecheck": "node ../../scripts/tsc-native.mjs --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@floating-ui/react": "^0.27.19",
    "@lexical/code": "0.53.0",
    "@lexical/code-core": "0.53.0",
    "@lexical/code-prism": "0.53.0",
    "@lexical/extension": "0.53.0",
    "@lexical/hashtag": "0.53.0",
    "@lexical/headless": "0.53.0",
    "@lexical/history": "0.53.0",
    "@lexical/html": "0.53.0",
    "@lexical/link": "0.53.0",
    "@lexical/list": "0.53.0",
    "@lexical/mark": "0.53.0",
    "@lexical/markdown": "0.53.0",
    "@lexical/overflow": "0.53.0",
    "@lexical/react": "0.53.0",
    "@lexical/rich-text": "0.53.0",
    "@lexical/selection": "0.53.0",
    "@lexical/table": "0.53.0",
    "@lexical/utils": "0.53.0",
    "@lexical/yjs": "0.53.0",
    "@monaco-editor/react": "^4.7.0",
    "@nimbalyst/collab-bundle": "workspace:*",
    "@nimbalyst/excalidraw-extension": "workspace:*",
    "@nimbalyst/extension-calc-sheets": "workspace:*",
    "@nimbalyst/extension-csv-spreadsheet": "workspace:*",
    "@nimbalyst/extension-datamodellm": "workspace:*",
    "@nimbalyst/local-wiki": "workspace:*",
    "@nimbalyst/mockuplm": "workspace:*",
    "@nimbalyst/web-editors": "workspace:*",
    "@revolist/react-datagrid": "4.21.4",
    "@revolist/revogrid": "4.21.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.2",
    "lexical": "0.53.0",
    "monaco-editor": "^0.55.1",
    "postcss": "^8.5.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^7.1.12",
