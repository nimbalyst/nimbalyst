{
  // Deliberately does NOT extend the repo root tsconfig.
  //
  // The root config maps `@nimbalyst/runtime/*` straight at runtime SOURCE and
  // uses `moduleResolution: bundler`. Both are wrong here: this package is a
  // plain Node process that must consume the `node` export condition runtime
  // publishes (`dist-node/`), because that is the artifact a headless host will
  // actually load. Resolving through the source paths would typecheck against
  // files that never reach `dist-node` and hide exactly the packaging breakage
  // this package exists to prove is gone.
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/__tests__/**", "dist"]
}
