<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+). Nothing is backed up to the cloud or copied during
     device-to-device transfer. Pairing and synced data are re-established on the
     new device by scanning the desktop QR code. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
