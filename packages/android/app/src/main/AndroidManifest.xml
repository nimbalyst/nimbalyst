<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Team pages are online-only; an offline open shows a native empty state. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The camera is used only for QR pairing and photo attachments; pairing can
         also be pasted in Settings, so camera-less devices stay eligible. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <!-- allowBackup=false does not stop Android 12+ device-to-device transfer.
         The rules exclude everything: pairing prefs are encrypted with a
         Keystore key that never leaves the device, so a transferred copy is
         undecryptable on the new phone. -->
    <application
        android:name=".NimbalystApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NimbalystAndroid">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.NimbalystAndroid.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="auth"
                    android:pathPrefix="/callback"
                    android:scheme="nimbalyst" />
            </intent-filter>
            <!-- nimbalyst://pair (e.g. the Camera app scanning the pairing QR) only
                 opens the in-app scanner. MainActivity discards the link's payload:
                 pairing data selects the sync server and encryption context, so it
                 is accepted only from the app's own camera. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="pair"
                    android:scheme="nimbalyst" />
            </intent-filter>
            <!-- Team console pages open in the app's Pages screen. Same paths as the
                 iOS apple-app-site-association; login, /connect, /public and
                 Personal (/app) pages are not listed, so they stay in the browser.
                 Verified against console.nimbalyst.com/.well-known/assetlinks.json. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:host="console.nimbalyst.com" />
                <data android:pathPattern="/org/.*/project/.*/wiki" />
                <data android:pathPattern="/org/.*/project/.*/wiki/.*" />
                <data android:pathPattern="/org/.*/project/.*/pages" />
                <data android:pathPattern="/org/.*/project/.*/pages/.*" />
                <data android:pathPattern="/org/.*/project/.*/document/.*" />
                <data android:pathPattern="/org/.*/project/.*/page/.*" />
                <data android:pathPattern="/org/.*/project/.*/view/.*" />
                <data android:pathPattern="/org/.*/project/.*/marks" />
                <data android:pathPattern="/org/.*/project/.*/trackers" />
                <data android:pathPattern="/org/.*/project/.*/trackers/.*" />
            </intent-filter>
            <!-- nimbalyst://console/<team path> from the desktop app. Carries only a
                 page path, validated before Pages loads it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="console"
                    android:scheme="nimbalyst" />
            </intent-filter>
            <!-- Note: nimbalyst://session/[id] is delivered only via the push
                 notification's explicit Intent(MainActivity) (see
                 NimbalystFirebaseMessagingService). No BROWSABLE intent-filter is
                 declared for it, which would needlessly let any web page invoke it. -->
        </activity>

        <!-- Full-resolution camera capture writes to app cache via this provider. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".notifications.NimbalystFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
