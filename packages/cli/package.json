{
  "name": "@nimbalyst/cli",
  "version": "0.2.0",
  "description": "nim — companion command-line tool for Nimbalyst trackers and agent interop",
  "license": "MIT",
  "author": "Nimbalyst Team",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nim": "./dist/bin/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "nimbalyst",
    "cli",
    "tracker",
    "issues",
    "agent"
  ],
  "homepage": "https://github.com/nimbalyst/nimbalyst/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/nimbalyst/nimbalyst/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nimbalyst/nimbalyst.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @nimbalyst/local-wiki run build && node scripts/build.mjs",
    "dev": "tsc --watch",
    "typecheck": "pnpm --filter @nimbalyst/local-wiki run build && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "optionalDependencies": {
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@nimbalyst/collab-protocol": "workspace:*",
    "@nimbalyst/local-wiki": "workspace:*",
    "@nimbalyst/tracker-core": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.2",
    "js-yaml": "^4.3.2",
    "typescript": "^5.0.0",
    "vitest": "4.1.11"
  }
}
