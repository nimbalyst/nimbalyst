{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@nimbalyst/runtime/core/pageMarkSyntax": ["./src/types/pageMarkSyntax.d.ts"],
      "@nimbalyst/runtime/core/textColorSyntax": ["./src/types/textColorSyntax.d.ts"],
      "@nimbalyst/runtime/editor/commenting/quoteMatch": ["./src/types/quoteMatch.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
