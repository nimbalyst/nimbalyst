{
  "name": "@nimbalyst/collab-client",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Shared headless and React collaboration client surfaces for Nimbalyst hosts.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./core": {
      "types": "./src/core/index.ts",
      "default": "./src/core/index.ts"
