      "default": "./src/docs/pageTreeToolCore.ts"
    },
    "./docs/pageTypes": {
      "types": "./src/docs/pageTypes/index.ts",
      "default": "./src/docs/pageTypes/index.ts"
    },
    "./docs-ui": {
      "types": "./src/docs-ui/index.ts",
      "default": "./src/docs-ui/index.ts"
    },
    "./docs-ui/setPageType": {
      "types": "./src/docs-ui/setPageType/index.ts",
