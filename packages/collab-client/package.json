      "types": "./src/trackers-ui/embed/index.ts",
      "default": "./src/trackers-ui/embed/index.ts"
    },
    "./trackers-ui/page": {
      "types": "./src/trackers-ui/page/index.ts",
      "default": "./src/trackers-ui/page/index.ts"
    },
    "./trackers-ui/references": {
      "types": "./src/trackers-ui/references/index.ts",
      "default": "./src/trackers-ui/references/index.ts"
    },
    "./trackers-ui/board.css": "./src/trackers-ui/board/TrackerBoardCard.css",
    "./trackers-ui/grid.css": "./src/trackers-ui/grid/trackerGrid.css",
