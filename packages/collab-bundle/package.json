{
  "name": "@nimbalyst/collab-bundle",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Prebuilt collaboration bundle for browser and native WebView hosts.",
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.css",
    "types"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./canvas": {
      "types": "./types/canvas.d.ts",
      "import": "./dist/canvas.js"
    },
    "./commenting-ui": {
      "types": "./types/commenting-ui.d.ts",
      "import": "./dist/commenting-ui.js"
    },
    "./editor": {
      "types": "./types/editor.d.ts",
      "import": "./dist/editor.js"
    },
    "./docs-ui": {
      "types": "./types/docs-ui.d.ts",
      "import": "./dist/docs-ui.js"
    },
    "./feedback-ui": {
      "types": "./types/feedback-ui.d.ts",
      "import": "./dist/feedback-ui.js"
    },
    "./trackers-ui": {
      "types": "./types/trackers-ui.d.ts",
      "import": "./dist/trackers-ui.js"
    },
    "./trackers-ui/TagBoard": {
      "types": "./types/internal/collab-client/src/trackers-ui/TagBoard.d.ts",
      "import": "./dist/trackers-ui.js"
    },
    "./trackers-ui/TrackerTimelineView": {
      "types": "./types/internal/collab-client/src/trackers-ui/TrackerTimelineView.d.ts",
      "import": "./dist/trackers-ui.js"
    },
    "./quick-open": {
   "types": "./types/quick-open.d.ts",
   "import": "./dist/quick-open.js"
  },
  "./inbox": {
      "types": "./types/inbox.d.ts",
      "import": "./dist/inbox.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "npm run build:types && node scripts/build-dist.mjs && npm run check:production-output",
    "build:types": "node scripts/build-types.mjs",
    "check:production-output": "node scripts/check-production-output.mjs",
    "typecheck": "npm run check:bundle",
    "test": "vitest --run --config vitest.config.ts",
    "check:bundle": "npm run build && tsc --noEmit && node ../../scripts/check-collab-bundle.mjs",
    "validate": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "jotai": "^2.16.1",
    "jotai-family": "^1.1.0"
  },
  "peerDependencies": {
    "@lexical/yjs": "^0.44.0",
    "@revolist/react-datagrid": "4.21.4",
    "@revolist/revogrid": "4.21.4",
    "lexical": "^0.44.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "y-protocols": "^1.0.6",
    "yjs": ">=13.5.42"
  },
  "devDependencies": {
    "@nimbalyst/collab-client": "*",
    "@nimbalyst/runtime": "*",
    "@revolist/react-datagrid": "4.21.4",
    "@revolist/revogrid": "4.21.4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "jsdom": "^26.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.5.0",
    "vite": "^7.1.12",
    "vitest": "4.1.8",
    "yjs": ">=13.5.42"
  }
}
