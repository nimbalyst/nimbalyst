{
  "name": "@nimbalyst/extension-crew",
  "version": "0.1.0",
  "description": "Crew: long-running agent personas with schedules, chapters, and a journal",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.tsx",
  "scripts": {
    "build": "vite build && vite build --config vite.backend.config.ts",
    "build:backend": "vite build --config vite.backend.config.ts",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "echo \"crew tests run via root vitest\""
  },
  "dependencies": {
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@nimbalyst/extension-sdk": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.3.0",
    "vite": "^7.0.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  }
}
