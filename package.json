{
  "name": "nimbalyst-monorepo",
  "version": "0.33.1",
  "private": true,
  "description": "Monorepo for Nimbalyst - A rich text editor built with Meta's Lexical framework",
  "author": "Nimbalyst Team",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.9.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "warn"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nimbalyst/nimbalyst.git"
  },
  "scripts": {
    "build": "pnpm --dir packages/runtime run build",
    "build:workspace-deps": "pnpm --filter @nimbalyst/tracker-core --filter @nimbalyst/extension-sdk --filter @nimbalyst/collab-protocol --filter @nimbalyst/tracker-schema --filter @nimbalyst/tracker-engine run build",
    "typecheck": "node scripts/run-workspace-script.mjs typecheck",
    "typecheck:prepush": "node scripts/run-validation.mjs typecheck",
    "test": "pnpm run test:unit",
    "test:unit": "vitest",
    "test:prepush": "vitest --run --reporter=dot --reporter=./scripts/vitest-run-log-reporter.mjs --silent=passed-only",
    "test:last": "node scripts/vitest-last-run.mjs",
    "test:prepush-gate": "node scripts/run-validation.mjs scripts sandbox",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest --coverage",
    "test:provider:integration": "cross-env RUN_AI_PROVIDER_TESTS=true vitest --run",
    "prepare": "node scripts/remove-stale-npm-lockfile.mjs && node scripts/install-git-hooks.mjs && pnpm run build:tracker-packages",
    "build:tracker-packages": "pnpm --filter @nimbalyst/tracker-core run build && pnpm --filter @nimbalyst/tracker-schema run build && pnpm --filter @nimbalyst/tracker-engine run build && pnpm --filter @nimbalyst/local-wiki run build",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "check:override-sync": "node scripts/check-override-sync.mjs",
    "build:wiki-plugin": "node scripts/build-wiki-plugin.mjs",
    "check:wiki-plugin": "node scripts/build-wiki-plugin.mjs --check",
    "check:text-nuls": "node scripts/check-text-file-nuls.mjs",
    "check:bundle-graph": "node scripts/check-main-bundle-graph.mjs",
    "check:collab-client-boundaries": "node scripts/check-collab-client-boundaries.mjs",
    "check:runtime-host-boundary": "node scripts/check-runtime-host-boundary.mjs",
    "check:identity-scopes": "node scripts/check-identity-scopes.mjs",
    "extension-sdk:check-public": "bash scripts/extension-sdk-public-checks.sh",
    "analyze": "node scripts/bundle-size.js",
    "analyze:top": "node scripts/bundle-size.js --top",
    "clean": "rm -rf packages/*/node_modules/.vite packages/*/dist node_modules/.cache",
    "clean:full": "rm -rf packages/*/node_modules packages/*/dist node_modules && pnpm install",
    "ios:test:swift": "pnpm --dir packages/ios run test:swift",
    "ios:build:transcript": "pnpm --dir packages/ios run build:transcript",
    "ios:build:editor": "pnpm --dir packages/ios run build:editor",
    "android:build:transcript": "pnpm --dir packages/android run build:transcript",
    "android:test:unit": "pnpm --dir packages/android run android:test:unit",
    "android:assemble:debug": "pnpm --dir packages/android run android:assemble:debug",
    "android:assemble:release": "pnpm --dir packages/android run android:assemble:release",
    "android:bundle:release": "pnpm --dir packages/android run android:bundle:release",
    "android:bundle:signed": "./scripts/android-bundle-signed.sh",
    "android:screenshots": "bash packages/android/scripts/take-screenshots.sh",
    "android:walkthrough": "bash packages/android/scripts/record-walkthrough.sh",
    "test:extensions": "bash scripts/run-extension-tests.sh",
    "marketplace:status": "node packages/marketplace/scripts/marketplace-status.mjs",
    "electron:resign": "bash scripts/resign-dev-electron.sh",
    "dev:url-handler": "bash scripts/install-dev-url-handler.sh",
    "check:json-accessor-indexes": "node scripts/check-json-accessor-indexes.mjs",
    "check:renderer-sync-sockets": "node scripts/check-renderer-sync-sockets.mjs",
    "check:native-dialogs": "node scripts/check-native-dialogs.mjs",
    "check:sync-floating-promises": "node scripts/check-sync-floating-promises.mjs",
    "check:shared-document-nodes": "node scripts/check-shared-document-nodes.mjs",
    "check:team-lane-crypto-names": "node scripts/check-team-lane-crypto-names.mjs",
    "check:tracker-policy-reads": "node scripts/check-tracker-policy-reads.mjs",
    "check:analytics-allowlist": "node scripts/check-analytics-allowlist.mjs",
    "test:cloudflare-sandbox": "pnpm --filter @nimbalyst/cloudflare-sandbox run typecheck && pnpm --filter @nimbalyst/cloudflare-sandbox run test:artifact && node --test packages/cloudflare-sandbox/container/checks/image-pins.test.mjs"
  },
  "devDependencies": {
    "@babel/plugin-transform-flow-strip-types": "^7.24.7",
    "@babel/preset-react": "^7.24.7",
    "@electric-sql/pglite-tools": "0.2.19",
    "@lexical/clipboard": "^0.44.0",
    "@lexical/code": "^0.44.0",
    "@lexical/code-shiki": "^0.44.0",
    "@lexical/dragon": "^0.44.0",
    "@lexical/file": "^0.44.0",
    "@lexical/hashtag": "^0.44.0",
    "@lexical/headless": "^0.44.0",
    "@lexical/history": "^0.44.0",
    "@lexical/link": "^0.44.0",
    "@lexical/list": "^0.44.0",
    "@lexical/mark": "^0.44.0",
    "@lexical/markdown": "^0.44.0",
    "@lexical/overflow": "^0.44.0",
    "@lexical/plain-text": "^0.44.0",
    "@lexical/react": "^0.44.0",
    "@lexical/rich-text": "^0.44.0",
    "@lexical/selection": "^0.44.0",
    "@lexical/table": "^0.44.0",
    "@lexical/text": "^0.44.0",
    "@lexical/utils": "^0.44.0",
    "@lexical/yjs": "^0.44.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "4.1.11",
    "ajv": "^8.17.1",
    "concurrently": "^9.2.0",
    "cross-env": "^10.1.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0",
    "lexical": "^0.44.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "semver": "^7.7.4",
    "terser": "^5.31.0",
    "typescript": "^5.0.0",
    "vitest": "4.1.11",
    "yaml": "^2.8.2"
  },
  "dependencies": {
    "ajv-formats": "^3.0.1",
    "content-type": "^1.0.5",
    "cors": "^2.8.5",
    "cross-spawn": "^7.0.6",
    "es-module-shims": "^2.7.0",
    "esbuild": "^0.28.1",
    "eventsource": "^4.1.0",
    "eventsource-parser": "^3.0.6",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "openai": "^6.9.1",
    "pkce-challenge": "^5.0.0",
    "raw-body": "^3.0.1",
    "virtua": "0.51.3",
    "zod-to-json-schema": "^3.25.0"
  }
}
