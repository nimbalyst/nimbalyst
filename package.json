{
  "name": "nimbalyst-monorepo",
  "version": "0.33.1",
  "private": true,
  "description": "Monorepo for Nimbalyst - A rich text editor built with Meta's Lexical framework",
  "author": "Nimbalyst Team",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nimbalyst/nimbalyst.git"
  },
  "scripts": {
    "build": "npm run build --prefix packages/runtime",
    "build:workspace-deps": "npm run build --workspace=@nimbalyst/tracker-core --workspace=@nimbalyst/extension-sdk",
    "typecheck": "node scripts/run-workspace-script.mjs typecheck",
    "typecheck:prepush": "npm run build:workspace-deps && npm run build --workspace=@nimbalyst/runtime -- --logLevel warn && npm run build --prefix packages/extensions/nimbalyst-memory/engine && npm run typecheck",
    "test": "npm run test:unit",
    "test:unit": "vitest",
    "test:prepush": "vitest --run --reporter=dot --reporter=./scripts/vitest-run-log-reporter.mjs --silent=passed-only",
    "test:last": "node scripts/vitest-last-run.mjs",
    "test:prepush-gate": "node --test --test-reporter=dot scripts/__tests__/prepush-test-gate.test.mjs scripts/__tests__/check-analytics-allowlist.test.mjs scripts/__tests__/check-collab-client-boundaries.test.mjs scripts/__tests__/check-identity-scopes.test.mjs scripts/__tests__/check-json-accessor-indexes.test.mjs scripts/__tests__/check-main-bundle-graph.test.mjs scripts/__tests__/check-push-authors.test.mjs scripts/__tests__/check-renderer-sync-sockets.test.mjs scripts/__tests__/check-shared-document-nodes.test.mjs scripts/__tests__/check-text-file-nuls.test.mjs scripts/__tests__/check-toolchain.test.mjs scripts/__tests__/check-tracker-policy-reads.test.mjs scripts/__tests__/main-bundle-require-policy.test.mjs scripts/__tests__/run-workspace-script.test.mjs scripts/__tests__/vitest-tree-fingerprint.test.mjs packages/electron/scripts/__tests__/dev-user2.test.mjs",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest --coverage",
    "test:provider:integration": "cross-env RUN_AI_PROVIDER_TESTS=true vitest --run",
    "prepare": "node scripts/install-git-hooks.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "check:override-sync": "node scripts/check-override-sync.mjs",
    "check:text-nuls": "node scripts/check-text-file-nuls.mjs",
    "check:bundle-graph": "node scripts/check-main-bundle-graph.mjs",
    "check:collab-client-boundaries": "node scripts/check-collab-client-boundaries.mjs",
    "check:identity-scopes": "node scripts/check-identity-scopes.mjs",
    "extension-sdk:check-public": "bash scripts/extension-sdk-public-checks.sh",
    "analyze": "node scripts/bundle-size.js",
    "analyze:top": "node scripts/bundle-size.js --top",
    "clean": "rm -rf packages/*/node_modules/.vite packages/*/dist node_modules/.cache",
    "clean:full": "rm -rf packages/*/node_modules packages/*/dist node_modules && npm install",
    "ios:test:swift": "npm run test:swift --prefix packages/ios",
    "ios:build:transcript": "npm run build:transcript --prefix packages/ios",
    "ios:build:editor": "npm run build:editor --prefix packages/ios",
    "android:build:transcript": "npm run build:transcript --prefix packages/android",
    "android:test:unit": "npm run android:test:unit --prefix packages/android",
    "android:assemble:debug": "npm run android:assemble:debug --prefix packages/android",
    "android:assemble:release": "npm run android:assemble:release --prefix packages/android",
    "android:bundle:release": "npm run android:bundle:release --prefix packages/android",
    "android:bundle:signed": "./scripts/android-bundle-signed.sh",
    "android:screenshots": "bash packages/android/scripts/take-screenshots.sh",
    "android:walkthrough": "bash packages/android/scripts/record-walkthrough.sh",
    "test:extensions": "bash scripts/run-extension-tests.sh",
    "marketplace:status": "node packages/marketplace/scripts/marketplace-status.mjs",
    "electron:resign": "bash scripts/resign-dev-electron.sh",
    "dev:url-handler": "bash scripts/install-dev-url-handler.sh",
    "postinstall": "patch-package",
    "check:json-accessor-indexes": "node scripts/check-json-accessor-indexes.mjs",
    "check:renderer-sync-sockets": "node scripts/check-renderer-sync-sockets.mjs",
    "check:shared-document-nodes": "node scripts/check-shared-document-nodes.mjs",
    "check:team-lane-crypto-names": "node scripts/check-team-lane-crypto-names.mjs",
    "check:tracker-policy-reads": "node scripts/check-tracker-policy-reads.mjs",
    "check:analytics-allowlist": "node scripts/check-analytics-allowlist.mjs"
  },
  "devDependencies": {
    "@babel/plugin-transform-flow-strip-types": "^7.24.7",
    "@babel/preset-react": "^7.24.7",
    "@electric-sql/pglite-tools": "0.2.19",
    "@lexical/clipboard": "^0.44.0",
    "@lexical/code": "^0.44.0",
    "@lexical/code-shiki": "^0.44.0",
    "@lexical/dragon": "^0.44.0",
    "@lexical/file": "^0.44.0",
    "@lexical/hashtag": "^0.44.0",
    "@lexical/headless": "^0.44.0",
    "@lexical/history": "^0.44.0",
    "@lexical/link": "^0.44.0",
    "@lexical/list": "^0.44.0",
    "@lexical/mark": "^0.44.0",
    "@lexical/markdown": "^0.44.0",
    "@lexical/overflow": "^0.44.0",
    "@lexical/plain-text": "^0.44.0",
    "@lexical/react": "^0.44.0",
    "@lexical/rich-text": "^0.44.0",
    "@lexical/selection": "^0.44.0",
    "@lexical/table": "^0.44.0",
    "@lexical/text": "^0.44.0",
    "@lexical/utils": "^0.44.0",
    "@lexical/yjs": "^0.44.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "ajv": "^8.17.1",
    "concurrently": "^9.2.0",
    "cross-env": "^10.1.0",
    "electron-builder": "^26.0.12",
    "lexical": "^0.44.0",
    "patch-package": "8.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "terser": "^5.31.0",
    "typescript": "^5.0.0",
    "vitest": "4.1.8"
  },
  "workspaces": [
    "packages/electron",
    "packages/runtime",
    "packages/cli",
    "packages/tracker-core",
    "packages/core",
    "packages/collab-protocol",
    "packages/collab-client",
    "packages/collab-bundle",
    "packages/collab-adapters",
    "packages/ios",
    "packages/android",
    "packages/extension-sdk",
    "packages/extensions/*",
    "packages/marketplace"
  ],
  "dependencies": {
    "@types/node-forge": "^1.3.14",
    "ajv-formats": "^3.0.1",
    "content-type": "^1.0.5",
    "cors": "^2.8.5",
    "cross-spawn": "^7.0.6",
    "es-module-shims": "^2.7.0",
    "esbuild": "^0.28.1",
    "eventsource": "^4.1.0",
    "eventsource-parser": "^3.0.6",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "monaco-editor": "^0.55.1",
    "node-forge": "^1.3.2",
    "node-pty": "^1.1.0",
    "openai": "^6.9.1",
    "pkce-challenge": "^5.0.0",
    "raw-body": "^3.0.1",
    "virtua": "^0.48.2",
    "zod-to-json-schema": "^3.25.0"
  },
  "overrides": {
    "@anthropic-ai/claude-agent-sdk": "0.3.257",
    "prismjs": "^1.30.0",
    "vite": "^7.3.6",
    "zod": "^4.0.0",
    "concurrently": {
      "shell-quote": "^1.8.4"
    },
    "minimatch@^10.0.0": "^10.2.5",
    "dompurify": "^3.4.14",
    "lodash-es": "^4.18.1",
    "@excalidraw/excalidraw": {
      "nanoid": "^3.3.18"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "^5.1.16"
    }
  },
  "allowScripts": {
    "@fortawesome/fontawesome-free@5.15.4": true,
    "@vscode/ripgrep@1.17.1": true,
    "better-sqlite3@13.0.1": true,
    "bufferutil@4.1.0": true,
    "core-js@3.48.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.10": true,
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "leveldown@5.6.0": true,
    "node-pty@1.1.0": true,
    "sharp@0.34.5": true,
    "utf-8-validate@5.0.10": true,
    "workerd@1.20260421.1": true
  }
}
