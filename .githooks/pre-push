#!/bin/sh
set -eu

# Git names the destination remote in $1 and streams one line per pushed ref on
# stdin. Read stdin before anything else -- it is consumed once.
remote_name="${1:-origin}"
push_refs=$(cat)

# Fail fast, and accurately, when the hook is running under the wrong Node.
# Every check below shells out to node/npm, and with engine-strict=true the
# lockfile check reports an engine mismatch as lockfile drift.
echo "[pre-push] Checking the Node/npm toolchain..."
if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
  echo "[pre-push] ERROR: node and npm are not both on PATH."
  echo "[pre-push] PATH=$PATH"
  echo "[pre-push] GUI git clients skip your shell config; push from a terminal, or point"
  echo "[pre-push] your version manager's default alias at the version in .nvmrc."
  exit 1
fi

# A release pushes main and then the tag on that same commit. The tag delivers no
# commit the remote lacks, so every gate below would re-validate the tree the
# branch push just proved. Skip it rather than spend the suite twice per release.
if [ "$(printf '%s\n' "$push_refs" | node scripts/prepush-test-gate.mjs --delivers "$remote_name")" = "none" ]; then
  echo "[pre-push] No new commits for $remote_name (already pushed); skipping the gates."
  exit 0
fi

# Keep stage timings even when a command fails; never turn a failure into a
# successful timing write. Epoch seconds are portable across Git Bash/macOS/Linux.
mkdir -p .vitest
printf '[]\n' > .vitest/last-prepush.json
run_stage() {
  stage_name=$1
  shift
  stage_start=$(date +%s)
  stage_status=0
  "$@" || stage_status=$?
  stage_elapsed=$(( $(date +%s) - stage_start ))
  echo "[pre-push] $stage_name: ${stage_elapsed}s (exit $stage_status)"
  node scripts/record-prepush-stage.mjs "$stage_name" "$stage_elapsed" "$stage_status"
  return "$stage_status"
}
run_stage toolchain node scripts/check-toolchain.mjs "$(npm -v)"

# Validate package-lock.json is in sync with every workspace package.json
# when the outgoing commits touch any manifest. This is exactly the check
# CI's `npm ci` performs; without it, lockfile drift is only discovered
# after pushing (2026-07-07 incident: npm 10/11 override-shape mismatch).
base=$(node scripts/resolve-prepush-base.mjs)

# Refuse to push escaped unit-test fixture commits (2026-07-22 incident: the
# pre-push vitest run leaked "Test User" commits onto public main).
echo "[pre-push] Checking outgoing commits for test-fixture authors..."
run_stage authors node scripts/check-push-authors.mjs "$base..HEAD"

# Hooks export repository-local GIT_* variables. In a linked worktree GIT_DIR
# is absolute, so a real-Git test running in a temp directory can otherwise
# mutate this branch and the shared repository config. Git documents this list
# specifically for commands that leave the hook's repository.
git_local_env=$(git rev-parse --local-env-vars)
# Intentional word splitting: rev-parse returns one variable name per line.
unset $git_local_env
unset GIT_NAMESPACE

check_lockfile() {
  if ! git diff --quiet "$base" HEAD -- package-lock.json 'package.json' '*/package.json' 2>/dev/null; then
    echo "[pre-push] Manifest/lockfile changed; validating lockfile sync (npm ci --dry-run)..."
    if ! npm ci --dry-run >/dev/null 2>&1; then
      echo ""
      echo "[pre-push] ERROR: package-lock.json is out of sync with package.json."
      echo "[pre-push] Run 'npm install' (Node 24 / npm 11 -- see .nvmrc) and commit the lockfile."
      npm ci --dry-run 2>&1 | grep -E 'Invalid|Missing|EBADENGINE' | head -10
      return 1
    fi
    echo "[pre-push] Lockfile in sync."
  fi

}
run_stage lockfile check_lockfile

echo "[pre-push] Checking override/dep sync..."
run_stage override-sync npm run check:override-sync

echo "[pre-push] Checking tracked text files for raw NUL bytes..."
run_stage text-nuls npm run check:text-nuls -- --ref HEAD

echo "[pre-push] Building typecheck prerequisites and running the full typecheck..."
run_stage typecheck:prepush npm run typecheck:prepush

echo "[pre-push] Verifying platform test-gate behavior..."
run_stage test:prepush-gate npm run test:prepush-gate

# Every line printed here lands in the Git extension's Output panel, so the
# prepush scripts use dot reporters, --silent=passed-only, and a quiet Vite
# build. A passing push is ~84 lines instead of ~25500 (most of which was
# console.log from the tests themselves). Failures still print in full.
if [ "$(node scripts/prepush-test-gate.mjs)" = "run" ]; then
  # typecheck:prepush already rebuilt generated artifacts. Untracked changes to
  # node_modules are not represented by Git; run test:prepush after manual edits
  # to installed dependencies. Non-HEAD refs conservatively use the normal gate.
  if [ "$(printf '%s\n' "$push_refs" | node scripts/prepush-test-gate.mjs --reuse)" = "reuse" ]; then
    run_stage test:prepush-reused true
  else
    echo "[pre-push] Running non-provider unit tests..."
    run_stage test:prepush npm run test:prepush
  fi
else
  echo "[pre-push] Skipping the full Vitest suite on local Windows; CI and non-Windows pushes still require it."
  echo "[pre-push] See docs/WINDOWS_PREPUSH_GATE.md for the tracked nonportable failures."
fi
